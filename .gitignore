# --- Secrets: NEVER commit environment files ---
.env
.env.*
!.env.example

# Python
__pycache__/
*.pyc
.venv/
.pytest_cache/
.ruff_cache/

# Node / Next.js
node_modules/
.next/
out/
*.tsbuildinfo
next-env.d.ts

# OS / editor
.DS_Store
Thumbs.db
.vscode/
.idea/

# Logs and local data
*.log
data/

# OpenClaw gateway token (secret)
.openclaw_token

# Hook config holds the ingest secret
openclaw-hook/config.json

# WhatsApp bridge: session credentials and secret.
# Two auth directories, because the observer and the sender link as separate
# devices. auth-sender/ was missing here until the sender was first linked —
# it holds credentials that can send messages as MORICE.
# WhatsApp device credentials. The glob matters: a logged-out session gets
# renamed (auth.logged-out-<date>) so it can be inspected before deletion, and
# an exact-path rule would leave those credentials committable.
apps/wa-bridge/auth*/
apps/wa-bridge/config.json
# The live pairing code and the page that renders it. Short-lived (WhatsApp
# rotates it every ~20s) but a credential while it lives: anyone who scans it
# links a device to the account.
apps/wa-bridge/qr-current-*.txt
apps/wa-bridge/qr-current-*.html
# Spooled messages are real personal conversation content awaiting delivery.
apps/wa-bridge/spool/
backups/
