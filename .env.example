# ARIA environment template.
# Copy to `.env` and fill in real values. `.env` is git-ignored — secrets never enter git.

# --- Application ---
APP_ENV=development           # development | production
LOG_LEVEL=INFO                # DEBUG | INFO | WARNING | ERROR

# --- Database (matches docker-compose.yml defaults for local dev) ---
DATABASE_URL=postgresql+asyncpg://aria:aria_dev_password@localhost:5432/aria

# --- Redis ---
REDIS_URL=redis://localhost:6379/0

# --- LLM providers (added in Phase 1; leave blank for now) ---
ANTHROPIC_API_KEY=

# --- Auth (Phase 4) ---
# Leave ARIA_PASSWORD empty to disable login while running locally only.
# To require login: set a strong password AND a random SECRET_KEY
# (generate one with:  python -c "import secrets; print(secrets.token_hex(32))")
ARIA_PASSWORD=
SECRET_KEY=dev-only-secret-change-me

# --- Outgoing email via SMTP (Phase 4, optional) ---
# Gmail: host smtp.gmail.com, port 587, user = your address,
# password = an App Password (Google account -> Security -> App passwords).
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
