# ==============================================================================
# ARIA PRODUCTION & DEVELOPMENT ENVIRONMENT TEMPLATE
# ==============================================================================
# Copy this file to `.env` for local development.
# In production:
#   - Set VERCEL variables in the Vercel Project Settings -> Environment Variables.
#   - Set DIGITALOCEAN variables in Docker Compose (.env) or DigitalOcean App Platform.
# NEVER commit `.env` to git.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. APPLICATION LAYER (VERCEL & CLIENT DASHBOARD)
# ------------------------------------------------------------------------------
# The public URL where the DigitalOcean backend is reachable by the browser.
# For local dev: http://localhost:8000
# For production: https://api.yourdomain.com (or your DigitalOcean App URL)
NEXT_PUBLIC_API_URL=http://localhost:8000

# ------------------------------------------------------------------------------
# 2. PERSISTENT BACKEND CORE (DIGITALOCEAN)
# ------------------------------------------------------------------------------
APP_ENV=development                   # development | staging | production
LOG_LEVEL=INFO                        # DEBUG | INFO | WARNING | ERROR

# --- Database & Cache ---
# Local Docker: postgresql+asyncpg://aria:aria_dev_password@localhost:5432/aria
# DigitalOcean Managed DB: postgresql+asyncpg://aria:<password>@<host>:25060/aria?ssl=require
DATABASE_URL=postgresql+asyncpg://aria:aria_dev_password@localhost:5432/aria
REDIS_URL=redis://localhost:6379/0

# --- Networking & CORS ---
# Comma-separated allowed origins for cross-origin browser requests from Vercel
# *.vercel.app is automatically allowed via regex. Add your custom production domains:
CORS_ORIGINS=https://aria.yourdomain.com,https://aria-web.vercel.app

# --- Authentication & Access Control ---
# Required in production. Generate a strong secret:
# python -c "import secrets; print(secrets.token_hex(32))"
ARIA_PASSWORD=
SECRET_KEY=dev-only-secret-change-me

# ------------------------------------------------------------------------------
# 3. AI & MODEL PROVIDERS
# ------------------------------------------------------------------------------
# Options: "gemini" | "claude" | "openai"
LLM_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash

ANTHROPIC_API_KEY=
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.1

# --- Local Models via Ollama (DigitalOcean Droplet with GPU/RAM or local dev) ---
# Leave model names empty to disable local tier and route all queries to cloud
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_FAST_MODEL=
OLLAMA_REASONING_MODEL=
CONVERSE_LOCAL=false
PREFER_LOCAL=false

# --- Web Search for Research Agent ---
WEB_SEARCH_ENABLED=true
WEB_SEARCH_PROVIDER=tavily             # tavily | duckduckgo
TAVILY_API_KEY=

# ------------------------------------------------------------------------------
# 4. WHATSAPP BRIDGE (DIGITALOCEAN BACKGROUND SERVICE)
# ------------------------------------------------------------------------------
# Shared secret protecting communication between wa-bridge processes and ARIA API
# Generate with: python -c "import secrets; print('aria_ingest_' + secrets.token_hex(24))"
OPENCLAW_INGEST_SECRET=
ARIA_API_URL=http://api:8000/whatsapp

# Background worker drain & polling settings
WHATSAPP_WORKER_ENABLED=true
WHATSAPP_WORKER_POLL_SECONDS=2.0

# ------------------------------------------------------------------------------
# 5. PROACTIVE ENGINE & SCHEDULER (DIGITALOCEAN)
# ------------------------------------------------------------------------------
PROACTIVE_ENABLED=true
PROACTIVE_INTERVAL_SECONDS=300.0

# ------------------------------------------------------------------------------
# 6. OBSERVABILITY & WEBHOOKS
# ------------------------------------------------------------------------------
# Sentry DSN for backend and worker error tracing (optional)
SENTRY_DSN=

# n8n Automation & External Integration
N8N_WEBHOOK_URL=
WEBHOOK_SECRET=

# ------------------------------------------------------------------------------
# 7. EMAIL INTEGRATION (OPTIONAL)
# ------------------------------------------------------------------------------
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
IMAP_HOST=
IMAP_PORT=993
